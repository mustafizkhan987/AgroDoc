<?xml version="1.0" encoding="utf-8"?>
<!--
    Downloadable font descriptor for Noto Sans Kannada Regular.
    Android will download from Google Fonts on first use (requires Google Play Services;
    works offline after first download because the font is cached on-device).
    OFL licence — see https://fonts.google.com/noto/specimen/Noto+Sans+Kannada
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="name=Noto Sans Kannada&amp;weight=400"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs">
</font-family>
